{
  "name": "ai-hackathon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "agent:push": "sh -c 'set -a; for f in .env .env.local; do [ -f \"$f\" ] && . \"./$f\"; done; set +a; AGENT_PUSH=1 vitest run agent/agent.test.ts && cd agent && elevenlabs tools push && elevenlabs agents push' && prettier --write agent"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@elevenlabs/react": "^1.22.1",
    "katex": "^0.19.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@elevenlabs/cli": "1.11.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.10.1",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
