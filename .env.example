# Copy to .env.local and fill in. Never commit values (ARCHITECTURE.md section 9).
# Required keys depend on the mode: see the mode table in ARCHITECTURE.md section 9.

# Real mode (npm start): required
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: without it, Ask shows "Questions are unavailable right now."
ELEVENLABS_AGENT_ID=
# Optional: without it, every image is hidden
FAL_KEY=

# 1 = fake Claude, ElevenLabs and fal from lib/fakes/ (tests and CI); no keys needed
FAKE_APIS=
# 1 = the browser uses the scripted fake Q&A agent. Inlined at build time.
NEXT_PUBLIC_FAKE_APIS=
# <lessonId> = serve the saved run in runs/<lessonId>/ with no provider calls
REPLAY_RUN=
# Where lesson runs are saved (default runs/). e2e sets runs-e2e/ so it never touches real runs.
RUNS_DIR=
